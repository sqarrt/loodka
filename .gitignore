# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# internal docs (specs/plans) — not published to the repo
/docs

# design exports (raw Claude Design output) — not published to the repo
/design

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env*.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# editor / local tooling
/.claude
/.idea
.zshrc

# scratch / credential handoff files — never commit
/mobile-screenshots
/supabase.md
/vercel.md
/task.md
